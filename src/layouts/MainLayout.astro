---
import Footer from "../components/ui/Footer.astro";
import Navbar from "../components/ui/Navbar.astro";
import MainHead from "./MainHead.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: { src: string; alt: string };
  robots?: boolean;
}

const props = Astro.props;
---

<html lang="en">
  <MainHead {...props} />
  <body class="bg-paper font-body text-text antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[60] focus:rounded-lg focus:bg-ink focus:px-4 focus:py-2 focus:text-white"
      >Skip to content</a
    >
    <Navbar />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
