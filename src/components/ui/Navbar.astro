---
import Logo from "./Logo.astro";
import { withBase } from "../../utils/url";

const links = [
  { href: withBase("/#scanner"), label: "Scanner" },
  { href: withBase("/#how-it-works"), label: "How it works" },
  { href: withBase("/#limits"), label: "What we do not promise" },
];

const cta = { href: withBase("/get-started"), label: "Get started" };
---

<!-- Opaque on purpose. A translucent bar loses the wordmark over the ink sections. -->
<header class="sticky top-0 z-50 bg-paper border-b border-border-soft">
  <div class="shell flex h-16 items-center justify-between gap-6">
    <a
      href={withBase("/")}
      class="flex items-center gap-2.5"
      aria-label="Intent Shark home"
    >
      <Logo size={24} tone="light" />
      <span class="font-display text-[19px] text-ink">Intent Shark</span>
    </a>

    <nav class="hidden md:flex items-center gap-8" aria-label="Main">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="text-[15px] text-muted hover:text-ink transition-colors"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <a href={cta.href} class="btn btn-primary !py-2 !px-4 text-[14px]">
        {cta.label}
      </a>
      <button
        id="nav-toggle"
        type="button"
        class="md:hidden inline-flex h-9 w-9 items-center justify-center rounded-lg border border-border-soft text-ink"
        aria-expanded="false"
        aria-controls="nav-panel"
        aria-label="Toggle navigation"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav
    id="nav-panel"
    class="hidden md:hidden border-t border-border-soft bg-paper"
    aria-label="Mobile"
  >
    <div class="shell py-4 flex flex-col gap-3">
      {
        links.map((link) => (
          <a href={link.href} class="text-[15px] text-muted hover:text-ink" data-nav-close>
            {link.label}
          </a>
        ))
      }
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById("nav-toggle");
  const panel = document.getElementById("nav-panel");

  if (toggle && panel) {
    toggle.addEventListener("click", () => {
      const open = panel.classList.toggle("hidden") === false;
      toggle.setAttribute("aria-expanded", String(open));
    });
    panel.querySelectorAll("[data-nav-close]").forEach((el) => {
      el.addEventListener("click", () => {
        panel.classList.add("hidden");
        toggle.setAttribute("aria-expanded", "false");
      });
    });
  }
</script>
