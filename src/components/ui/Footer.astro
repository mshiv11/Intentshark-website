---
import Logo from "./Logo.astro";
import { withBase } from "../../utils/url";

const year = new Date().getFullYear();

const links = [
  { href: withBase("/#scanner"), label: "Scanner" },
  { href: withBase("/#how-it-works"), label: "How it works" },
  { href: withBase("/#why-reddit"), label: "Why Reddit" },
  { href: withBase("/#limits"), label: "What we do not promise" },
  { href: withBase("/get-started"), label: "Get started" },
];
---

<footer class="bg-ink text-white border-t border-linedk">
  <div class="shell py-16">
    <div class="flex flex-col gap-12 md:flex-row md:justify-between">
      <div class="max-w-sm">
        <a
          href={withBase("/")}
          class="flex items-center gap-2.5"
          aria-label="Intent Shark home"
        >
          <Logo size={24} tone="dark" />
          <span class="font-display text-[19px] text-white">Intent Shark</span>
        </a>
        <p class="mt-5 text-[15px] text-mint/70">
          Reddit and AI-search visibility for B2B software brands. We build the
          ground you own. We speak only where we are allowed.
        </p>
        <p class="mt-5 eyebrow eyebrow-dark">
          If we cannot say who we work for in a room, we do not talk about the
          client in it.
        </p>
      </div>

      <nav aria-label="Footer">
        <p class="eyebrow eyebrow-dark">Pages</p>
        <ul class="mt-4 flex flex-col gap-3">
          {
            links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-[15px] text-white/80 hover:text-mint transition-colors"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div
      class="mt-14 border-t border-linedk pt-6 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="eyebrow eyebrow-dark">&copy; {year} Intent Shark</p>
      <p class="eyebrow eyebrow-dark">Month to month. You keep what we build.</p>
    </div>
  </div>
</footer>
