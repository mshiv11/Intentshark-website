---
import MainLayout from "../layouts/MainLayout.astro";
import Section from "../components/sections/Section.astro";
import { withBase } from "../utils/url";

/* =====================================================================
   SWAP THESE FOR REAL VALUES
   ---------------------------------------------------------------------
   INBOX        the address the enquiry email is addressed to
   BOOKING_URL  a Cal.com / Calendly link. Leave as "" to hide the
                "or book directly" line until a real link exists.
   ===================================================================== */
const INBOX = "m@intentshark.com";
const BOOKING_URL = "";
/* ===================================================================== */

const homeUrl = withBase("/");

const paths = [
  {
    id: "engagement",
    value: "Full service engagement (90 days)",
    title: "Book a full service engagement",
    body: "The 90-day programme. Two client-owned subreddits, three disclosed accounts, roughly 48 comments a month, fortnightly reporting. Month to month after the first 90 days.",
    recommended: true,
  },
  {
    id: "call",
    value: "Intro consultation call",
    title: "Book a consultation call",
    body: "A short intro call. We look at what is already being said about you, tell you which rooms allow a vendor to speak, and say plainly whether this is worth doing for your category.",
    recommended: false,
  },
];
---

<MainLayout
  title="Get started | Intent Shark"
  description="Book an intro call or the 90-day Reddit and AI-search visibility engagement with Intent Shark."
>
  <!-- ============================================ INTRO -->
  <section class="bg-ink text-white">
    <div class="shell pt-16 pb-20 md:pt-20 md:pb-24">
      <p class="eyebrow eyebrow-dark">Get started</p>
      <h1 class="display-1 mt-6 max-w-3xl text-white">
        Pick the smaller step or the whole thing.
      </h1>
      <p class="mt-6 max-w-2xl text-[18px] text-white/75">
        Both start the same way. We read what is already there, room by room,
        and tell you what is true about your brand on Reddit today.
      </p>

      <p id="site-echo" class="mt-8 hidden">
        <span class="pill pill-dark">
          From the scanner:
          <span id="site-echo-value" class="ml-1 text-white"></span>
        </span>
      </p>
    </div>
  </section>

  <!-- ============================================ FORM -->
  <Section tone="paper">
    <form id="start-form" novalidate class="max-w-3xl">
      <!-- path selection -->
      <fieldset class="border-0 p-0 m-0">
        <legend class="eyebrow">Choose one</legend>
        <div class="mt-5 grid gap-4 md:grid-cols-2">
          {
            paths.map((path, index) => (
              <label
                class="path-card group relative flex cursor-pointer flex-col rounded-card border border-border-soft bg-white p-6 transition-colors"
                for={`path-${path.id}`}
              >
                <input
                  class="path-radio sr-only"
                  type="radio"
                  name="path"
                  id={`path-${path.id}`}
                  value={path.value}
                  checked={index === 0}
                />
                <span class="flex items-center justify-between gap-3">
                  <span class="eyebrow">
                    {path.recommended ? "Recommended" : "Lighter step"}
                  </span>
                  <span
                    class="path-dot inline-block h-4 w-4 shrink-0 rounded-full border border-border-soft"
                    aria-hidden="true"
                  />
                </span>
                <span class="mt-4 font-display text-[21px] text-ink">
                  {path.title}
                </span>
                <span class="mt-3 text-[15px] text-muted">{path.body}</span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <!-- details -->
      <div class="mt-12 border-t border-border-soft pt-10">
        <p class="eyebrow">Your details</p>

        <div class="mt-6 grid gap-5 md:grid-cols-2">
          <div class="md:col-span-2">
            <label class="block text-[14px] text-muted" for="email">
              Email <span style="color: var(--rust);">(required)</span>
            </label>
            <input
              id="email"
              name="email"
              type="email"
              autocomplete="email"
              required
              class="field mt-2"
              placeholder="you@company.com"
              aria-describedby="email-error"
            />
            <p
              id="email-error"
              role="alert"
              class="mt-2 hidden text-[14px]"
              style="color: var(--rust);"
            >
            </p>
          </div>

          <div class="md:col-span-2">
            <label class="block text-[14px] text-muted" for="site">
              Website (optional)
            </label>
            <input
              id="site"
              name="site"
              type="text"
              inputmode="url"
              spellcheck="false"
              class="field mt-2"
              placeholder="yourcompany.com"
            />
          </div>

          <div>
            <label class="block text-[14px] text-muted" for="name">
              Name (optional)
            </label>
            <input
              id="name"
              name="name"
              type="text"
              autocomplete="name"
              class="field mt-2"
              placeholder="Your name"
            />
          </div>

          <div>
            <label class="block text-[14px] text-muted" for="company">
              Company (optional)
            </label>
            <input
              id="company"
              name="company"
              type="text"
              autocomplete="organization"
              class="field mt-2"
              placeholder="Company name"
            />
          </div>
        </div>

        <div class="mt-8 flex flex-wrap items-center gap-4">
          <button type="submit" class="btn btn-primary">
            Open the email draft
          </button>
          <p class="eyebrow max-w-sm">
            This site has no backend. Submitting opens a prefilled email in your
            mail app. Nothing is stored here.
          </p>
        </div>
      </div>
    </form>

    <!-- confirmation -->
    <div
      id="start-done"
      class="mt-12 hidden max-w-3xl rounded-card border border-border-soft bg-white p-8 md:p-10"
      role="status"
      aria-live="polite"
    >
      <p class="eyebrow">Draft opened</p>
      <h2 class="display-3 mt-3 text-ink">
        Your mail app should be showing a draft to {INBOX}.
      </h2>
      <p class="mt-4 text-[16px] text-muted">
        We did not send anything and we did not store anything. Press send in
        your mail app and it reaches us. If no draft appeared, your browser
        blocked the handoff. Copy the text below into an email instead.
      </p>

      <div class="mt-6 border-t border-border-soft pt-6">
        <p class="eyebrow">To</p>
        <p class="mt-1 text-[15px] text-ink">{INBOX}</p>
        <p class="eyebrow mt-5">Message</p>
        <pre
          id="start-summary"
          class="mt-2 whitespace-pre-wrap rounded-lg border border-border-soft bg-paper p-4 font-mono text-[13px] text-text"></pre>
      </div>

      <div class="mt-7 flex flex-wrap gap-3">
        <button id="start-copy" type="button" class="btn btn-ghost">
          Copy the details
        </button>
        <button id="start-again" type="button" class="btn btn-ghost">
          Change something
        </button>
        {
          BOOKING_URL && (
            <a
              href={BOOKING_URL}
              target="_blank"
              rel="noopener"
              class="btn btn-primary"
            >
              Or book a time directly
            </a>
          )
        }
      </div>
    </div>
  </Section>

  <!-- ============================================ REASSURANCE -->
  <Section tone="ink" divider>
    <div class="grid gap-10 md:grid-cols-3">
      <div>
        <p class="eyebrow eyebrow-dark">What happens next</p>
        <h3 class="mt-3 font-display text-[21px] text-white">
          A reply, then a short call
        </h3>
        <p class="mt-3 text-[15px] text-white/70">
          We answer with what we already found about your brand. If it looks
          thin, we say so and you save your money.
        </p>
      </div>
      <div>
        <p class="eyebrow eyebrow-dark">No lock-in</p>
        <h3 class="mt-3 font-display text-[21px] text-white">
          Month to month after the first 90 days
        </h3>
        <p class="mt-3 text-[15px] text-white/70">
          No annual contract. Stop whenever the work stops being worth it.
        </p>
      </div>
      <div>
        <p class="eyebrow eyebrow-dark">You keep it</p>
        <h3 class="mt-3 font-display text-[21px] text-white">
          The subreddits and the documentation are yours
        </h3>
        <p class="mt-3 text-[15px] text-white/70">
          Both subreddits are registered to you. So is the brand account and
          every page of the factual record we write.
        </p>
      </div>
    </div>

    <p class="eyebrow eyebrow-dark mt-14 border-t border-linedk pt-8">
      If we cannot say who we work for in a room, we do not talk about the
      client in it.
    </p>
  </Section>

  <Section tone="paper">
    <a href={homeUrl} class="btn btn-ghost">Back to the scanner</a>
  </Section>
</MainLayout>

<style>
  .path-card:has(.path-radio:checked) {
    border-color: var(--green);
  }
  .path-card:has(.path-radio:checked) .path-dot {
    border-color: var(--green);
    background: var(--green);
    box-shadow: inset 0 0 0 3px var(--white);
  }
  .path-card:has(.path-radio:focus-visible) {
    outline: 2px solid var(--green);
    outline-offset: 2px;
  }
</style>

<script is:inline define:vars={{ IS_INBOX: INBOX }}>
  (function () {
    "use strict";

    var form = document.getElementById("start-form");
    var doneEl = document.getElementById("start-done");
    var summaryEl = document.getElementById("start-summary");
    var emailEl = document.getElementById("email");
    var emailError = document.getElementById("email-error");
    var siteEl = document.getElementById("site");
    var nameEl = document.getElementById("name");
    var companyEl = document.getElementById("company");
    var echoEl = document.getElementById("site-echo");
    var echoValue = document.getElementById("site-echo-value");
    var copyBtn = document.getElementById("start-copy");
    var againBtn = document.getElementById("start-again");

    if (!form) return;

    /* ------------------------------- prefill from ?site= */

    try {
      var params = new URLSearchParams(window.location.search);
      var site = (params.get("site") || "").trim();
      if (site) {
        siteEl.value = site;
        echoValue.textContent = site;
        echoEl.classList.remove("hidden");
      }
    } catch (e) {
      /* querystring is optional, carry on */
    }

    /* ------------------------------- validation */

    var EMAIL_RE = /^[^\s@]+@[^\s@]+\.[a-z]{2,}$/i;

    function showEmailError(msg) {
      emailError.textContent = msg;
      emailError.classList.remove("hidden");
      emailEl.setAttribute("aria-invalid", "true");
      emailEl.focus();
    }

    function clearEmailError() {
      emailError.textContent = "";
      emailError.classList.add("hidden");
      emailEl.removeAttribute("aria-invalid");
    }

    emailEl.addEventListener("input", clearEmailError);

    /* ------------------------------- compose */

    function selectedPath() {
      var checked = form.querySelector('input[name="path"]:checked');
      return checked ? checked.value : "Not selected";
    }

    function compose() {
      var path = selectedPath();
      var lines = [
        "I would like to: " + path,
        "",
        "Email: " + emailEl.value.trim(),
        "Website: " + (siteEl.value.trim() || "not given"),
        "Name: " + (nameEl.value.trim() || "not given"),
        "Company: " + (companyEl.value.trim() || "not given"),
        "",
        "Sent from the Intent Shark website.",
      ];
      return {
        subject: "Intent Shark: " + path,
        body: lines.join("\n"),
      };
    }

    form.addEventListener("submit", function (event) {
      event.preventDefault();
      clearEmailError();

      var email = emailEl.value.trim();
      if (!email) {
        showEmailError("We need an email address to reply to.");
        return;
      }
      if (!EMAIL_RE.test(email)) {
        showEmailError("That email address does not look right.");
        return;
      }

      var composed = compose();
      summaryEl.textContent =
        "Subject: " + composed.subject + "\n\n" + composed.body;

      doneEl.classList.remove("hidden");

      // Try the mail handoff. If the browser blocks it, the panel above
      // already shows everything needed to send it by hand.
      try {
        var href =
          "mailto:" +
          IS_INBOX +
          "?subject=" +
          encodeURIComponent(composed.subject) +
          "&body=" +
          encodeURIComponent(composed.body);
        window.location.href = href;
      } catch (e) {
        /* nothing to do, the fallback panel is already visible */
      }

      doneEl.scrollIntoView({ behavior: "smooth", block: "start" });
    });

    /* ------------------------------- confirmation controls */

    if (copyBtn) {
      copyBtn.addEventListener("click", function () {
        var text = summaryEl.textContent || "";
        var label = copyBtn.textContent;
        function done(ok) {
          copyBtn.textContent = ok ? "Copied" : "Select and copy manually";
          window.setTimeout(function () {
            copyBtn.textContent = label;
          }, 2200);
        }
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(text).then(
            function () {
              done(true);
            },
            function () {
              done(false);
            },
          );
        } else {
          done(false);
        }
      });
    }

    if (againBtn) {
      againBtn.addEventListener("click", function () {
        doneEl.classList.add("hidden");
        form.scrollIntoView({ behavior: "smooth", block: "start" });
        emailEl.focus();
      });
    }
  })();
</script>
