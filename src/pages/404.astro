---
import MainLayout from "../layouts/MainLayout.astro";
import Logo from "../components/ui/Logo.astro";
import { withBase } from "../utils/url";
---

<MainLayout
  title="Page not found | Intent Shark"
  description="That page does not exist."
  robots={true}
>
  <section class="bg-ink text-white">
    <div class="shell flex min-h-[70vh] flex-col justify-center py-24">
      <Logo size={40} tone="dark" />
      <p class="eyebrow eyebrow-dark mt-8">Error 404</p>
      <h1 class="display-1 mt-5 max-w-2xl text-white">
        That page is not in the room either.
      </h1>
      <p class="mt-6 max-w-xl text-[17px] text-white/70">
        The link is wrong or the page has moved. The scanner is still where you
        left it.
      </p>
      <div class="mt-10 flex flex-wrap gap-3">
        <a href={withBase("/")} class="btn btn-mint">Back to the scanner</a>
        <a href={withBase("/get-started")} class="btn btn-ghost-dark">
          Get started
        </a>
      </div>
    </div>
  </section>
</MainLayout>
